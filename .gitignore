# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# App data / local databases
*.db
*.db-wal
*.db-shm

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Exported session transcripts
20??-??-??-*.txt

# Review-gate verdicts are per-commit and local.
.claude/context/reviews/

# One session, one worktree, one branch — EnterWorktree checks out in here.
# Without this, every session's worktree is untracked noise in every other one.
.claude/worktrees/

# Credentials never belong in the tree. The R2 publish token lives in Windows
# Credential Manager (keyring); these patterns are the backstop for the moment
# someone stages a token file they meant to keep local (2026-09-10).
# Extension-agnostic on purpose: the first real one to land was a .txt.
*creds*
*credentials*
*secret*
*.token
